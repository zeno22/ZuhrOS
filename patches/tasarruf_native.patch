     sk_sp<SkColorFilter> displayColorTransform;
     if (display.colorTransform != mat4() && !display.deviceHandlesColorTransform) {
         displayColorTransform = SkColorFilters::Matrix(toSkColorMatrix(display.colorTransform));
     }
+
+// --- TASARRUF INJECTION: BRUTALIST E-INK SKSL WITH MILD OVERLAY ---
+    if (property_get_bool("persist.sys.sf.eink_filter", false)) {
+        static sk_sp<SkRuntimeEffect> sEinkEffect;
+        
+        // Compile the SkSL shader only once
+        if (!sEinkEffect) {
+            // We use vec4 for all uniforms to guarantee 16-byte memory alignment.
+            const char* sksl = R"(
+                uniform vec4 stepsInfo; 
+                uniform vec4 paperColor;
+                uniform vec4 inkColor;
+
+                // Pseudo-random hash function seeded by color
+                float hash(vec3 c, vec3 seed) {
+                    return fract(sin(dot(c, seed)) * 43758.5453);
+                }
+
+                half4 main(half4 color) {
+                    float steps = stepsInfo.x;
+                    float ditherSpread = stepsInfo.y; // Threshold noise intensity
+                    
+                    // Extract Luminance (REC.709)
+                    float luma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
+                    
+                    // 1. Chromatic Dithering (Threshold Shift)
+                    float noise1 = hash(color.rgb, vec3(12.9898, 78.233, 37.719));
+                    float ditheredLuma = luma + (noise1 - 0.5) * ditherSpread;
+                    
+                    // 2. Non-linear Quantization
+                    float quantizedLuma = floor(ditheredLuma * steps + 0.5) / steps;
+                    quantizedLuma = clamp(quantizedLuma, 0.0, 1.0);
+                    
+                    // 3. Map to utility palette
+                    vec3 finalColor = mix(inkColor.rgb, paperColor.rgb, quantizedLuma);
+                    
+                    // 4. The Mild Chromatic Overlay
+                    // Generate independent noise to act as a physical "veil"
+                    float noise2 = hash(color.rgb, vec3(41.24, 15.32, 74.89));
+                    
+                    // Subtract a small percentage of light to simulate a stippled texture
+                    // 0.04 represents the "mildness". Increase to make it harsher.
+                    finalColor -= (noise2 * 0.04);
+                    
+                    // 5. Alpha Hack: Prevent premultiplied alpha GPU crashes
+                    float finalAlpha = color.a;
+                    if (finalAlpha == 0.0) {
+                        finalColor = vec3(0.0);
+                    }
+                    
+                    return half4(finalColor, finalAlpha);
+                }
+            )";
+            
+            auto result = SkRuntimeEffect::MakeForColorFilter(SkString(sksl));
+            if (result.effect) {
+                sEinkEffect = result.effect;
+            } else {
+                ALOGE("Tasarruf Injection: SkSL compilation failed: %s", result.errorText.c_str());
+            }
+        }
+
+        // Apply the statically cached effect
+        if (sEinkEffect) {
+            struct EinkUniforms {
+                float stepsInfo[4]; 
+                float paperColor[4];
+                float inkColor[4];
+            };
+            
+            EinkUniforms uniforms = {
+                {3.0f, 0.15f, 0.0f, 0.0f},                   // 3 shades, 0.15 threshold spread
+                {0.85f, 0.85f, 0.80f, 1.0f},                 // Dull paper
+                {0.10f, 0.12f, 0.15f, 1.0f}                  // Faded navy ink
+            };
+            
+            sk_sp<SkData> uniformsData = SkData::MakeWithCopy(&uniforms, sizeof(uniforms));
+            sk_sp<SkColorFilter> einkFilter = sEinkEffect->makeColorFilter(uniformsData);
+            
+            if (displayColorTransform) {
+                displayColorTransform = displayColorTransform->makeComposed(einkFilter);
+            } else {
+                displayColorTransform = einkFilter;
+            }
+        }
+    }
